  "on": [
    {
      "event": "issue.labeled:todo",
      "flow": "issue/poc",
      "description": "Build a failing regression and bounded PoC for every maintainer-accepted TODO"
    },
    {
      "event": "change.opened",
      "flow": "checks/review",
      "description": "Review every Change across consensus, memory safety, compliance, and performance lenses"
    },
    {
      "event": "change.updated",
      "flow": "checks/review",
      "description": "Re-review every updated Change before maintainer merge"
    },
    {
      "event": "change.landed",
      "flow": "wiki-refresh",
      "description": "Refresh the Engineering Wiki and Mythical History after a Change lands"
    },
    {
      "event": "github.push:main",
      "flow": "wiki-refresh",
      "description": "Refresh the Engineering Wiki and audit report after main advances"
    },
    {
      "event": "schedule:0 4 * * *",
      "flow": "uphill",
      "description": "Run the nightly Uphill Lighthouse backpressure audit on main"
    },
    {
      "event": "schedule:0 10 * * 1",
      "flow": "release-check",
      "description": "Weekly Monday release lockstep, SDK packaging, and docs audit"
    }
  ],
  "github": {
    "mirror": "pull",
    "issues": "two-way",
    "changes": "send-upstream",
    "protectedPaths": [
      "src/evm.zig",
      "src/eips_and_hardforks",
      "src/frame",
      "src/core/verified_ops.zig",
      "build.zig",
      "build.zig.zon",
      ".github/workflows",
      ".smithers/FACTORY.ts",
      ".smithers/WORKSPACE.ts",
      ".smithers/PACKAGE.ts",
      ".agents/uphill"
    ],
    "maintainers": [
      "roninjin10",
      "fucory"
    ],
    "dailyTokens": 1000000000
  },
  "policy": {
    "lifecycle": {
      "docs": "evergreen",
      "tests": "evergreen"
    },
    "notifications": {
      "quietHours": []
    },
    "approvals": {
      "approve": "person",
      "merge": "person"
    }
  },
  "machine": {
    "vcpus": 4,
    "memoryMiB": 8192,
    "tools": [
      "zig",
      "cargo",
      "rustc",
      "cc",
      "bun",
      "node"
    ]
  },
  "issueViews": [
    {
      "id": "todos",
      "title": "Accepted TODOs",
      "state": "open",
      "labels": [
        "todo"
      ]
    },
    {
      "id": "consensus",
      "title": "Consensus and EVM",
      "state": "open",
      "labels": [
        "consensus"
      ]
    },
    {
      "id": "verification",
      "title": "Formal verification",
      "state": "open",
      "labels": [
        "verification"
      ]
    },
    {
      "id": "performance",
      "title": "Performance and JIT",
      "state": "open",
      "labels": [
        "performance"
      ]
    },
    {
      "id": "sdks",
      "title": "C and TypeScript SDKs",
      "state": "open",
      "labels": [
        "sdk"
      ]
    },
    {
      "id": "needs-repro",
      "title": "Needs reproduction",
      "state": "open",
      "labels": [
        "needs-repro"
      ]
    }
  ],
  "issueTransitions": [
    {
      "id": "request-repro",
      "title": "Request minimal reproduction",
      "to": "needs-repro",
      "actor": "anyone"
    },
    {
      "id": "accept",
      "title": "Accept issue for implementation",
      "from": "needs-repro",
      "to": "accepted",
      "actor": "person"
    },
    {
      "id": "promote-todo",
      "title": "Promote to factory TODO",
      "from": "accepted",
      "to": "todo",
      "actor": "person"
    }
  ],
  "contributes": {
    "triggers": [
      {
        "on": "github.push",
        "flow": "ci",
        "title": "CI on main and gate branches",
        "branches": [
          "main",
          "gate/**"
        ]
      },
      {
        "on": "github.pull_request",
        "flow": "ci",
        "title": "CI on pull requests"
      },
      {
        "on": "manual",
        "flow": "ci",
        "title": "Run Guillotine CI"
      },
      {
        "on": "github.pull_request",
        "flow": "uphill",
        "title": "Uphill Lighthouse audit on pull requests"
      },
      {
        "on": "cron",
        "flow": "uphill",
        "title": "Nightly Uphill Lighthouse audit",
        "cron": "0 4 * * *",
        "timezone": "UTC",
        "overlap": "skip"
      },
      {
        "on": "manual",
        "flow": "uphill",
        "title": "Run Lighthouse Backpressure Audit"
      },
      {
        "on": "github.push",
        "flow": "wiki",
        "title": "Refresh Engineering Wiki on main",
        "branches": [
          "main"
        ]
      },
      {
        "on": "manual",
        "flow": "wiki",
        "title": "Rebuild Engineering Wiki and Mythical History"
      },
      {
        "on": "manual",
        "flow": "release",
        "title": "Verify release readiness and docs build"
      }
    ]
  }
}
