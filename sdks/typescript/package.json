{
	"name": "@tevm/guillotine",
	"version": "0.1.0",
	"description": "Guillotine EVM for TypeScript: Bun FFI bindings to the native libguillotine_ffi library",
	"keywords": [
		"evm",
		"ethereum",
		"guillotine",
		"zig",
		"ffi",
		"bun",
		"typescript"
	],
	"homepage": "https://github.com/evmts/guillotine/tree/main/sdks/typescript",
	"bugs": {
		"url": "https://github.com/evmts/guillotine/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/evmts/guillotine.git",
		"directory": "sdks/typescript"
	},
	"license": "MIT",
	"contributors": [
		"Will Cory <willcory10@gmail.com>",
		"0xpolarzero <contact@polarzero.dev>"
	],
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"bun": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"prebuilds",
		"README.md"
	],
	"engines": {
		"bun": ">=1.1.0"
	},
	"scripts": {
		"build": "tsup",
		"build:native": "cd ../.. && zig build shared -Doptimize=ReleaseFast && cd sdks/typescript && bun scripts/copy-native.ts",
		"clean": "rm -rf dist prebuilds",
		"format": "biome format . --write",
		"lint": "biome check .",
		"lint:package": "publint --strict && attw --pack --profile esm-only",
		"prepublishOnly": "bun run build:native && bun run build && bun run typecheck && bun test && bun run lint:package",
		"test": "bun test",
		"test:coverage": "bun test --coverage",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@biomejs/biome": "^2.6.8",
		"@types/bun": "^1.4.1",
		"publint": "^0.3.25",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3"
	},
	"publishConfig": {
		"access": "public"
	}
}
